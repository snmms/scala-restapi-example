# Routes
# Tech Products Store API

# Home
# GET     /                                       controllers.HomeController.index()
GET     /                  controllers.Assets.versioned(path="/public", file="index.html")
GET     /assets/*file      controllers.Assets.versioned(path="/public", file)

# Health
GET     /health                                 controllers.HealthController.check()

# Categorias
GET     /api/v1/categorias                       controllers.CategoriaController.list()
GET     /api/v1/categorias/:id                   controllers.CategoriaController.get(id: Long)

# Productos
GET     /api/v1/productos                        controllers.ProductoController.list(categoria: Long ?= 0, precioMin: Double ?= 0.0, precioMax: Double ?= 0.0, bajoStock: Boolean ?= false, disponible: Boolean ?= false, ordenar: String ?= "id")
GET     /api/v1/productos/:id                    controllers.ProductoController.get(id: Long)
POST    /api/v1/productos                        controllers.ProductoController.create()
PUT     /api/v1/productos/:id                    controllers.ProductoController.update(id: Long)
DELETE  /api/v1/productos/:id                    controllers.ProductoController.delete(id: Long)
GET     /api/v1/productos/categoria/:id          controllers.ProductoController.byCategoria(id: Long)

# Ventas
GET     /api/v1/ventas                           controllers.VentaController.list()
GET     /api/v1/ventas/:id                       controllers.VentaController.get(id: Long)
POST    /api/v1/ventas                           controllers.VentaController.create()
GET     /api/v1/ventas/productos-mas-vendidos    controllers.VentaController.bestSellers()

# Static assets
# GET     /assets/*file                           controllers.Assets.versioned(path="/public", file: Asset)
